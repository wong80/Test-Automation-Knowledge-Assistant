# Model selection (provider-agnostic via litellm). Swap providers by changing LLM_MODEL.
# No key required for local Ollama models.
LLM_MODEL=gpt-4o-mini

# OpenAI (default provider for LLM_MODEL=gpt-4o-mini / gpt-4o)
OPENAI_API_KEY=sk-proj-...

# Anthropic (for LLM_MODEL=anthropic/claude-sonnet-4-6)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama local models (for LLM_MODEL=ollama/llama3) — no API key, requires Ollama running
# OLLAMA_HOST=http://localhost:11434
